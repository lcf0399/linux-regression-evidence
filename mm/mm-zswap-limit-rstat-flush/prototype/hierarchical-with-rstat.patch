 	/* Local (CPU and cgroup) page state & events */
@@ -6212,6 +6217,35 @@ static struct cftype swap_files[] = {
 };
 
 #ifdef CONFIG_ZSWAP
+/*
+ * Evaluation of Joanne Koong's hierarchical per-CPU experiment (9092e0057f03).
+ * Keep the existing rstat updates: public usage and shrinker accounting still
+ * consume them. Only the limit pre-check uses this additional counter.
+ * Callers hold rcu_read_lock() and use the same memcg as their rstat update.
+ */
+static void memcg_zswap_hier_add(struct mem_cgroup *memcg, long val)
+{
+	struct memcg_vmstats_percpu __percpu *statc_pcpu;
+	struct memcg_vmstats_percpu *statc;
+
+	statc_pcpu = memcg->vmstats_percpu;
+	for (; statc_pcpu; statc_pcpu = statc->parent_pcpu) {
+		statc = this_cpu_ptr(statc_pcpu);
+		this_cpu_add(statc_pcpu->zswap_hier, val);
+	}
+}
+
+static unsigned long memcg_zswap_hier_sum(struct mem_cgroup *memcg)
+{
+	long sum = 0;
+	int cpu;
+
+	for_each_possible_cpu(cpu)
+		sum += READ_ONCE(per_cpu_ptr(memcg->vmstats_percpu,
+					     cpu)->zswap_hier);
+	return max(sum, 0L);
+}
+
