+static void *io_rsrc_node_refill(struct io_alloc_cache *cache)
+{
+	void *node;
+	int i, nr;
+
+	/* Called only on an empty node cache; registration does not prefill it. */
+	nr = kmalloc_bulk(sizeof(struct io_rsrc_node), GFP_KERNEL,
+			  cache->max_cached, cache->entries);
+	if (!nr)
+		return io_cache_alloc_new(cache, GFP_KERNEL);
+	node = cache->entries[nr - 1];
+	for (i = 0; i < nr - 1; i++) {
+		void *entry = cache->entries[i];
+
+		if (!io_alloc_cache_put(cache, entry))
+			kfree(entry);
+	}
+	return node;
+}
+
