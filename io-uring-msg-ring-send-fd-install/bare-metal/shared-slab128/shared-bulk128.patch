+/* Diagnostic interface: the shared buckets and requested-size checks stay. */
+int kmalloc_bulk_noprof(size_t bytes, gfp_t flags, size_t nr, void **p)
+{
+	struct kmem_cache *s;
+	unsigned long caller = _RET_IP_;
+	int i, got;
+
+	if (!nr || nr > INT_MAX || !bytes || bytes > KMALLOC_MAX_CACHE_SIZE)
+		return 0;
+	s = kmalloc_slab(bytes, NULL, flags, caller);
+	got = alloc_bulk(s, flags, nr, p, bytes);
+	for (i = 0; i < got; i++) {
+		p[i] = kasan_kmalloc(s, p[i], bytes, flags);
+		trace_kmalloc(caller, p[i], bytes, s->size, flags, NUMA_NO_NODE);
+	}
+	return got;
+}
+EXPORT_SYMBOL(kmalloc_bulk_noprof);
 
